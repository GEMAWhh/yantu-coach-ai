YANTU_APP_ENV=dev
YANTU_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
YANTU_AUTH_TOKEN_SHA256=
# Production only: use a TLS-protected PostgreSQL URL. Do not commit the actual value.
YANTU_DATABASE_URL=
# Production only: configure all three values together. Never expose the Secret Key to Web builds.
YANTU_SUPABASE_URL=
YANTU_SUPABASE_SECRET_KEY=
YANTU_SUPABASE_STORAGE_BUCKET=
# Evidence analysis defaults to the fake provider. Real keys are server-side secrets only.
YANTU_EVIDENCE_AI_PROVIDER=fake
YANTU_EVIDENCE_AI_API_KEY=
# DeepSeek defaults to https://api.deepseek.com and deepseek-flash.
# OpenAI-compatible services (for example Bailian or SiliconFlow) require both values.
YANTU_EVIDENCE_AI_BASE_URL=
YANTU_EVIDENCE_AI_MODEL=
YANTU_EVIDENCE_AI_TIMEOUT_SECONDS=60
