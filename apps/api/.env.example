YANTU_APP_ENV=dev
YANTU_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
YANTU_AUTH_TOKEN_SHA256=
# Production only: use a TLS-protected PostgreSQL URL. Do not commit the actual value.
YANTU_DATABASE_URL=
# Production only: configure all three values together. Never expose the Secret Key to Web builds.
YANTU_SUPABASE_URL=
YANTU_SUPABASE_SECRET_KEY=
YANTU_SUPABASE_STORAGE_BUCKET=
