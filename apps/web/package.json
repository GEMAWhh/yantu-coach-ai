{
  "name": "yantu-coach-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vue-tsc --noEmit && vite build",
    "build:demo": "vue-tsc --noEmit && vite build --mode demo",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --environment jsdom src",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "pinia": "2.3.0",
    "vue-router": "4.5.0",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.5",
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.17.0",
    "eslint-plugin-vue": "9.32.0",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.0",
    "vite": "6.0.7",
    "vitest": "2.1.8",
    "vue-eslint-parser": "9.4.3",
    "vue-tsc": "2.2.0"
  }
}
